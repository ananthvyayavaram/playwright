# QA environment configuration
# Usage: test_env=qa npx playwright test
#
# Copy this file to .env.qa (same directory) and fill in QA values.
# The .env.qa file is gitignored — never commit real credentials.

BASE_URL=https://qa.your-app.example.com
BASE_URL_2=https://qa-admin.your-app.example.com

USERNAME=qa-testuser@example.com
PASSWORD=QaPassword123!

ADMIN_USERNAME=qa-admin@example.com
ADMIN_PASSWORD=QaAdminPassword123!
