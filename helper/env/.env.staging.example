# Staging environment configuration
# Usage: test_env=staging npx playwright test
#
# Copy this file to .env.staging (same directory) and fill in staging values.

BASE_URL=https://staging.your-app.example.com
BASE_URL_2=https://staging-admin.your-app.example.com

USERNAME=staging-testuser@example.com
PASSWORD=StagingPassword123!

ADMIN_USERNAME=staging-admin@example.com
ADMIN_PASSWORD=StagingAdminPassword123!
